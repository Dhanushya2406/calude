{
  "manifest_version": 3,
  "name": "Snackable",
  "version": "1.3.3",
  "description": "Auto-pulls your YouTube Watch Later queue into an intentional watch list with notes, highlights, and analytics.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "scripting", "declarativeNetRequest"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Snackable"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
